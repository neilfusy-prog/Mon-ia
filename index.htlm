<!DOCTYPE html>

<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Mon IA</title>

  <!-- Puter.js -->

  <script src="https://js.puter.com/v2/"></script>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #080b18;
      color: white;
      min-height: 100vh;
    }

    header {
      padding: 20px;
      text-align: center;
      background: #10162d;
      border-bottom: 1px solid #29304f;
    }

    header h1 {
      margin: 0;
      font-size: 28px;
    }

    header p {
      margin: 8px 0 0;
      color: #9da7d1;
    }

    #chat {
      max-width: 800px;
      margin: auto;
      padding: 20px;
      padding-bottom: 100px;
    }

    .message {
      padding: 14px 16px;
      margin: 12px 0;
      border-radius: 15px;
      line-height: 1.5;
      white-space: pre-wrap;
    }

    .user {
      background: #26315f;
      margin-left: 15%;
    }

    .ai {
      background: #151c35;
      margin-right: 15%;
    }

    .loading {
      opacity: 0.7;
    }

    .bottom {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 12px;
      background: #080b18;
      border-top: 1px solid #29304f;
    }

    .input-box {
      max-width: 800px;
      margin: auto;
      display: flex;
      gap: 8px;
    }

    input {
      flex: 1;
      min-width: 0;
      padding: 14px;
      border-radius: 12px;
      border: 1px solid #39436d;
      background: #11162a;
      color: white;
      outline: none;
      font-size: 16px;
    }

    button {
      padding: 14px 18px;
      border: none;
      border-radius: 12px;
      background: #5865f2;
      color: white;
      font-weight: bold;
      cursor: pointer;
    }

    button:disabled {
      opacity: 0.5;
    }

    @media (max-width: 600px) {
      .user {
        margin-left: 5%;
      }

      .ai {
        margin-right: 5%;
      }

      button {
        padding: 14px;
      }
    }
  </style>

</head>

<body>

<header>
  <h1>🤖 Mon IA</h1>
  <p>Mon assistant personnel</p>
</header>

<div id="chat">
  <div class="message ai">
    👋 Salut ! Je suis ton IA. Pose-moi une question !
  </div>
</div>

<div class="bottom">
  <div class="input-box">
    <input
      id="message"
      type="text"
      placeholder="Écris ta question..."
      autocomplete="off"
    >

```
<button id="sendButton" onclick="sendMessage()">
  Envoyer
</button>
```

  </div>
</div>

<script>
  const input = document.getElementById("message");
  const chat = document.getElementById("chat");
  const sendButton = document.getElementById("sendButton");

  async function sendMessage() {
    const text = input.value.trim();

    if (!text || sendButton.disabled) {
      return;
    }

    // Message de l'utilisateur
    const userMessage = document.createElement("div");
    userMessage.className = "message user";
    userMessage.textContent = text;
    chat.appendChild(userMessage);

    input.value = "";
    sendButton.disabled = true;

    // Message temporaire de l'IA
    const aiMessage = document.createElement("div");
    aiMessage.className = "message ai loading";
    aiMessage.textContent = "🤔 Je réfléchis...";
    chat.appendChild(aiMessage);

    window.scrollTo(0, document.body.scrollHeight);

    try {
      const response = await puter.ai.chat(
        [
          {
            role: "system",
            content:
              "Tu es une IA généraliste appelée Mon IA. " +
              "Réponds toujours en français sauf si l'utilisateur demande une autre langue. " +
              "Sois claire, utile et adaptée à un adolescent. " +
              "Tu peux parler de sciences, technologie, jeux vidéo, école, créativité, " +
              "astronomie et de nombreux autres sujets."
          },
          {
            role: "user",
            content: text
          }
        ],
        {
          model: "gpt-5.4-nano"
        }
      );

      let answer = "";

      if (typeof response === "string") {
        answer = response;
      } else if (response?.message?.content) {
        answer = response.message.content;
      } else {
        answer = JSON.stringify(response);
      }

      aiMessage.classList.remove("loading");
      aiMessage.textContent = answer;

    } catch (error) {
      console.error(error);

      aiMessage.classList.remove("loading");
      aiMessage.textContent =
        "❌ Je n'arrive pas à contacter le cerveau de l'IA. " +
        "Réessaie dans quelques secondes.";
    }

    sendButton.disabled = false;
    input.focus();

    window.scrollTo(0, document.body.scrollHeight);
  }

  input.addEventListener("keydown", function(event) {
    if (event.key === "Enter") {
      sendMessage();
    }
  });
</script>

</body>
</html>
